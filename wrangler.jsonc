{
  // Cloudflare Worker com static assets (mesmo modelo do botequei).
  // O Worker (worker/index.mjs) roteia /api/* e delega o resto pro binding ASSETS.
  //
  // Setup inicial:
  //   1. npx wrangler kv namespace create SESSIONS   → cole o "id" retornado em kv_namespaces abaixo
  //   2. openssl rand -base64 32 | npx wrangler secret put ENCRYPTION_KEY   (ou pelo dashboard como Secret)
  //   3. npx wrangler deploy   (ou conecte o repo no dash pra deploy no git push)
  "name": "wazeplaces",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-06-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // A sala de presença (um Durable Object `SalaDO` por fila) saiu na fase 4:
  // desde a fase 3 a lista e a conversa são as do WME. O binding foi tirado, e
  // a migração `v2` APAGA a classe — com o namespace e o que ele guardasse (a
  // sala não gravava nada: a presença era a conexão aberta).
  //
  // As migrações são um HISTÓRICO: a `v1` fica. A Cloudflare aplica só as
  // tags posteriores à última já aplicada, e tirar a `v1` faria o deploy
  // procurar uma história que não bate com a do servidor. `exports` (a forma
  // nova, declarativa) não entra junto: os dois campos são mutuamente
  // exclusivos, e a configuração com os dois é recusada.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SalaDO"] },
    { "tag": "v2", "deleted_classes": ["SalaDO"] }
  ],
  // «Manter conectado»: a cada 30 minutos o Worker renova o cookie do Waze das
  // sessões que ligaram isso (server/manter-conectado.mjs). Cada execução olha a
  // FATIA da vez das entradas (posição na lista ordenada e hora: toda entrada é
  // visitada a cada ~10 execuções com 100 pessoas), lê no máximo 15 e renova no
  // máximo 6 devidas (carimbo com mais de 10 h): 48 × 6 = 288 renovações por dia.
  // MEDIDO por simulação (8 dias, pessoas ausentes): ~100 pessoas com folga (0–1
  // morte em 600), 125 no limite (0 a 1,2 %; com entradas e saídas a toda hora a
  // margem cai); acima disso a conta não fecha no
  // plano grátis. A cota de ESCRITA do KV (1.000/dia, dividida com o
  // uso normal do app e com a regravação diária da entrada) aperta antes do cron.
  // Pra mais gente: Workers Paid e subir MANTER_LOTE no módulo (conferindo as 50
  // subrequisições por execução e a CPU), ou encurtar o cron aqui. O cron só
  // roda no deploy do Worker em produção, não no `wrangler dev` (use
  // `wrangler dev --test-scheduled` e chame /__scheduled).
  "triggers": { "crons": ["*/30 * * * *"] },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "75ffae4a7cfd42b19bc3a1ed6ce41224"
    }
  ],
  // Domínio custom declarado aqui pra sobreviver a `wrangler deploy`. Sem isto, um
  // deploy pode remover o domínio (que ficava só no dashboard). custom_domain: true
  // faz o wrangler criar/adotar o Custom Domain apontando pra este Worker.
  "routes": [
    { "pattern": "places.wazebrasil.com", "custom_domain": true }
  ]
}
