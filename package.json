{
  "name": "wazeplaces",
  "version": "3.0.0",
  "private": true,
  "description": "PWA estilo Tinder pra editores do Waze Map Editor triarem pedidos de places",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/antigerme/wazeplaces.git"
  },
  "scripts": {
    "start": "node server/node.mjs",
    "dev": "node server/node.mjs",
    "check": "for f in js/*.js server/*.mjs worker/*.mjs; do node --check \"$f\"; done",
    "test": "node --test",
    "css": "npx --yes tailwindcss@3.4.17 -c tailwind.config.js -i css/tailwind.src.css -o css/tailwind.css --minify",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  }
}
