{
  "name": "wazeplaces",
  "version": "3.0.0",
  "private": true,
  "description": "PWA estilo Tinder pra editores do Waze Map Editor triarem pedidos de places",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/antigerme/wazeplaces.git"
  },
  "scripts": {
    "start": "node server/node.mjs",
    "dev": "node server/node.mjs",
    "check": "for f in js/*.js server/*.mjs worker/*.mjs; do node --check \"$f\"; done",
    "test": "node --test",
    "test:browser": "node tools/smoke-browser.mjs",
    "css": "node tools/gerar-css.mjs",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "test:presenca": "node tools/smoke-presenca.mjs",
    "test:fluxo": "node tools/smoke-fluxo.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
